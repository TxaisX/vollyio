# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local agent tooling stays untracked, but checked-in skills load for every
# session: ignore .claude's contents except the skills folder.
/.agents/
/.claude/*
!/.claude/skills/
/skills-lock.json
/.mcp.json.bak

# scratch / troubleshooting notes
/The fix is a full restart of Claude Code.md

# local build output and agent tooling
/dist/
.codex/
.openai/

# local eval data (frames from personal/source footage; never committed)
evals/cases/*.json
evals/work/
evals/RESULTS.json
evals/GROUPS.json

# local render/lighthouse scratch
/.cache/

# root-level benchmark scratch (model/effort attack eval, jul 2026).
# same reasoning as evals/ above: these hold frames cut from personal source
# footage and are regenerable from the runner scripts, so they stay local.
/frames/
/raw/
/judging/
/codex-attack-model-effort-eval/

# generated benchmark reports. self-contained html with the source frames
# inlined as base64 (the attacker report alone is ~18mb), so committing one
# commits the footage twice over. rebuild with build-report.mjs instead.
/attack-analysis-palominos.html
/model-effort-cost-ladder.html
/sideout-attacker-model-effort-report.html
/sideout-commercialization.html

# bulk run output. machine-written, superseded on every rerun, and only
# meaningful next to the frames above.
/benchmark-ranking.json
/matrix-results.json
/consensus-synthesis.json

# deliberately NOT ignored, even though they came from the same run:
# run-matrix.mjs, run-judges.mjs, run-stability.mjs, build-report.mjs,
# coach-output.schema.json, judge-output.schema.json, coach-prompt.txt,
# video-evidence-notes.md. these are the methodology, not the output — small,
# hand-written, and what makes the benchmark reproducible. commit them.
# caveat: /codex-attack-model-effort-eval/ above is ignored wholesale and
# contains its own copies of those scripts and schemas; the root-level copies
# are the ones meant to be tracked.

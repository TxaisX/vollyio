# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent tooling stays untracked, but checked-in skills load for every
# session: ignore .claude's contents except the skills folder.
/.agents/
/.claude/*
!/.claude/skills/
/skills-lock.json
/.mcp.json.bak

# local build output and agent tooling
/dist/
.codex/
.openai/

# Local eval data: frames cut from personal/source footage, never committed.
# evals/cases-pro-regression/ is deliberately NOT here. It is the one tracked
# case set, because the committed BASELINE.json resolves its ids against it.
evals/cases/*.json
evals/footage/
evals/clips/
evals/RESULTS.json
/eval-results/

# local render/lighthouse scratch
/.cache/

# archive/: historical material kept on disk for reference.
# - Retired text docs and small report cards were moved here with `git mv` and
#   stay tracked, so their history is preserved and they remain greppable.
# - Heavy regenerable outputs (benchmark reports, run JSON) and footage frames
#   are untracked and ignored; the ~18mb model-effort report inlines the source
#   footage as base64, so it is never committed. The small hand-written
#   methodology that reproduces those runs lives in scripts/benchmark/ (tracked).
# Ignore new untracked archive content; keep the tracked items and the index.
/archive/*
!/archive/README.md
!/archive/handoff-history.md

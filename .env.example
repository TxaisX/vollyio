# Vollyio environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local or any real secret.

# --- Supabase (public: safe to expose to the browser) ---
# Project URL and anon/publishable key from the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Coaching service (server-side only; never exposed to the browser) ---
# API key for the coaching service. Keep this secret and out of version control.
ANTHROPIC_API_KEY=your-coaching-service-key

# --- Site URL (used for metadataBase, canonical URLs, sitemap, robots) ---
# Local dev defaults to http://localhost:3000 when unset.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is provided automatically and used as a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Support mailbox (public: shown on the legal pages and footer Contact link) ---
# Set to a real, monitored mailbox in production; the Privacy Policy promises
# deletion within 30 days of an email to this address. Falls back to
# support@<SITE_URL host> when unset (see lib/site.ts).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Optional feature flags ---
# Set to "true" to return canned coaching responses without calling the coaching service
# (useful for local development and tests). Leave unset in production.
AI_MOCK=

# Set to "true" to enforce billing entitlements. Leave unset to keep analysis open.
# Enforcement requires BOTH this flag and NEXT_PUBLIC_UPGRADE_URL below (D-029):
# on its own this is inert, because capping free accounts with no way to pay
# would lock every player out permanently behind a 402 pointing nowhere.
BILLING_ENABLED=

# Where the "free analysis used" response sends a player. Leave unset until a
# paid tier actually ships; setting it is the second key that arms BILLING_ENABLED.
NEXT_PUBLIC_UPGRADE_URL=

# Model routing and reasoning effort are NOT environment variables. They are
# checked-in constants in lib/ai/client.ts (see decisions.md D-004 and D-027),
# deliberately: a typo in a model string would surface as a runtime 404 on a
# paid call path rather than at build time.

# Required to run the local-only evaluation endpoint. Use a long random value
# and send it as a Bearer token. Never set this in browser-visible variables.
EVAL_TOKEN=
